{
  "manifest_version": 3,
  "name": "Smart Shopping Agent",
  "version": "0.5.1",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/gopal2804/SmartShopping-AIAgent",
  "description": "Neutral shopping assistant for Amazon.in and Flipkart: review analysis, cross-site prices, review trust and price alerts.",
  "permissions": ["sidePanel", "scripting", "storage", "alarms", "notifications", "offscreen"],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.flipkart.com/*",
    "https://smart-shopping-agent-api.onrender.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Smart Shopping Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*", "https://www.flipkart.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
