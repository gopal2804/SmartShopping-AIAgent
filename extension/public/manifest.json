{
  "manifest_version": 3,
  "name": "Smart Shopping Agent",
  "version": "0.1.0",
  "description": "AI review analysis and product Q&A for Amazon.in and Flipkart.",
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.flipkart.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Smart Shopping Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*", "https://www.flipkart.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
