OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6-luna
# Lower is faster. Accepted values vary by model (gpt-6-luna: none|low|…; gpt-5-mini: minimal|low|…).
OPENAI_CHAT_REASONING_EFFORT=none
OPENAI_ANALYSIS_REASONING_EFFORT=low

# --- Protection (required in production) ---
# Signs install tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
# Enables GET /admin/usage (send as X-Admin-Token). Leave empty to disable.
ADMIN_TOKEN=
# Set to 1 when running behind a proxy such as Render, so per-IP limits use the real client IP.
TRUST_PROXY=0

# --- Limits (per install, per Indian calendar day) ---
LIMIT_ANALYZE_PER_DAY=20
LIMIT_CHAT_PER_DAY=100
LIMIT_MATCH_PER_DAY=60
LIMIT_TRUST_PER_DAY=60
LIMIT_REGISTRATIONS_PER_IP_PER_DAY=10

# --- Spend cap (USD per calendar month); also set a budget in the OpenAI dashboard ---
MONTHLY_BUDGET_USD=10
# USD per 1M tokens for OPENAI_MODEL, used to compute spend
PRICE_INPUT_PER_M=0.10
PRICE_CACHED_INPUT_PER_M=0.01
PRICE_OUTPUT_PER_M=0.50

# Where usage counters and spend are stored (SQLite)
USAGE_DB_PATH=data/usage.db
